generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
enum Role {
  admin
  agent
}

enum SessionStatus {
  normal
  needs_review
}

enum AlertType {
  volume_eleve
  domaine_bloque
}

enum AlertStatus {
  active
  resolved
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(agent)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Session {
  id                String        @id @default(uuid())
  identifiantUsager String
  appareil          String
  debut             DateTime
  fin               DateTime?
  volumeOctets      BigInt
  domaineDns        String?
  status            SessionStatus @default(normal)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  alerts Alert[]

  @@map("sessions")
}

model BlockedDomain {
  id        String   @id @default(uuid())
  domain    String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedBy String?

  @@map("domaines_bloques")
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Alert {
  id         String      @id @default(uuid())
  sessionId  String
  type       AlertType
  status     AlertStatus @default(active)
  message    String
  createdAt  DateTime    @default(now())
  resolvedAt DateTime?
  resolvedBy String?

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("alerts")
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}