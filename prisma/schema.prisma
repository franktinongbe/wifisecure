generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
enum Role {
  admin
  agent
}

enum SessionStatus {
  normal
  needs_review
}

enum AlertType {
  volume_eleve
  domaine_bloque
}

enum AlertStatus {
  active
  resolved
}

model User {
  id           String   @id @default(uuid())
  organizationId String
  email        String
  passwordHash String
  fullName     String
  role         Role     @default(agent)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  newsPosts    NewsPost[]
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([email])
  @@index([organizationId, role])
  @@map("users")
}

model Organization {
  id           String   @id @default(uuid())
  slug         String   @unique @db.VarChar(80)
  name         String   @db.VarChar(100)
  label        String   @default("Portail de connexion Wi-Fi") @db.VarChar(120)
  contactEmail String   @default("")
  phone        String   @default("")
  address      String   @default("")
  logoUrl      String   @default("")
  primaryColor String   @default("#2148a6") @db.VarChar(7)
  ingestTokenHash String @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  users        User[]
  sessions     Session[]
  newsPosts    NewsPost[]
  blockedDevices BlockedDevice[]
  blockedDomains BlockedDomain[]
  settings     Setting[]
  auditLogs    AuditLog[]

  @@map("organizations")
}

model Session {
  id                String        @id @default(uuid())
  organizationId    String
  identifiantUsager String
  appareil          String
  role              Role          @default(agent)
  debut             DateTime
  fin               DateTime?
  volumeOctets      BigInt
  domaineDns        String?
  adresseIp         String?
  adresseMac        String?
  navigateur        String?
  status            SessionStatus @default(normal)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  alerts Alert[]
  blocks BlockedDevice[]
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, role, debut])
  @@index([organizationId, debut])
  @@index([organizationId, fin, debut])
  @@map("sessions")
}

model NewsPost {
  id          String   @id @default(uuid())
  organizationId String
  title       String   @db.VarChar(180)
  summary     String?  @db.VarChar(360)
  content     String   @db.Text
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  attachments NewsAttachment[]
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([createdBy])
  @@index([organizationId, published, publishedAt])
  @@map("actualites_bibliotheque")
}

model NewsAttachment {
  id           String   @id @default(uuid())
  newsPostId   String
  fileName     String   @db.VarChar(255)
  storagePath  String   @unique
  contentType  String   @db.VarChar(100)
  sizeBytes    Int
  createdAt    DateTime @default(now())

  newsPost NewsPost @relation(fields: [newsPostId], references: [id], onDelete: Cascade)

  @@index([newsPostId, createdAt])
  @@map("actualite_pieces_jointes")
}

model BlockedDevice {
  id                String   @id @default(uuid())
  organizationId    String
  adresseMac        String   @unique
  adresseIp         String?
  identifiantUsager String
  appareil          String
  navigateur        String?
  infraction        String
  sessionId         String
  active            Boolean  @default(true)
  blockedAt         DateTime @default(now())
  blockedBy         String
  unblockedAt       DateTime?
  unblockedBy       String?

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, adresseMac])
  @@index([organizationId, active, blockedAt])
  @@index([sessionId])
  @@map("appareils_bloques")
}

model BlockedDomain {
  id        String   @id @default(uuid())
  organizationId String
  domain    String
  role      Role     @default(agent)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedBy String?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, domain, role])
  @@index([organizationId, role, active])
  @@map("domaines_bloques")
}

model Setting {
  id        String   @id @default(uuid())
  organizationId String
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("settings")
}

model Alert {
  id         String      @id @default(uuid())
  sessionId  String
  type       AlertType
  status     AlertStatus @default(active)
  message    String
  createdAt  DateTime    @default(now())
  resolvedAt DateTime?
  resolvedBy String?

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("alerts")
}

model AuditLog {
  id        String   @id @default(uuid())
  organizationId String
  actorId   String?
  action    String
  details   String?
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}
