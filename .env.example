# Copy to .env, then replace every placeholder before starting Docker.
DATABASE_URL=
DIRECT_URL=
SESSION_DATABASE_URL=
SESSION_SECRET=
FRONTEND_URL=https://your-frontend.example
WIFI_INGEST_TOKEN=

# UniFi Network local API
UNIFI_MODE=http
UNIFI_API_BASE_URL=https://unifi.example/proxy/network
UNIFI_API_KEY=
UNIFI_SITE_ID=
UNIFI_CA_CERT_PATH=apps/ingestor/certs/udm.pem
UNIFI_CA_CERT_HOST_PATH=./apps/ingestor/certs/udm.pem
UNIFI_INSECURE_TLS=false
WIFI_ORGANIZATION_SLUG=legacy
INGESTOR_INTERVAL_MS=15000

# Optional storage integration
SUPABASE_URL=
SUPABASE_SECRET_KEY=
